# Google Gemini API Key for Ask AI synthesis
# Obtain at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini Model name (default: gemini-flash-lite-latest or gemini-2.0-flash)
GEMINI_MODEL=gemini-flash-lite-latest

# Shared secret between Frontend proxy and Backend API
# Generate a secure 32-byte key with: openssl rand -hex 32
FRONTEND_SECRET=your_32_byte_hex_secret_here

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional Port (default: 8080)
PORT=8080
