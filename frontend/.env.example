# Backend API URL (for local development, points to local Go server on :8080)
# In production, points to your Hugging Face Space URL (e.g. https://dhruvil8-dharmapragya.hf.space)
BACKEND_URL=http://127.0.0.1:8080

# Shared secret matching the Go backend's FRONTEND_SECRET
# Generate a secure 32-byte key with: openssl rand -hex 32
FRONTEND_SECRET=your_32_byte_hex_secret_here
